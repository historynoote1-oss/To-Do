generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String     @id @default(cuid())
  username            String     @unique
  passwordHash        String
  isAdmin             Boolean    @default(false)
  isActive            Boolean    @default(true)

  // ===== الملف الشخصي (اسم عرض، نبذة، أفتار) =====
  // منفصلين تمامًا عن username (اللي بيستخدم للدخول وثابت)، عشان المستخدم
  // يقدر يخصّص شكل ظهوره من غير ما يأثر على حسابه أو أي بيانات مرتبطة بيه.
  // avatarUrl: مسار صورة الأفتار اللي المستخدم رفعها بنفسه (بدل الألوان
  // والإيموجي القديمة) — لو null، الواجهة بتعرض الحرف الأول من اسمه بدلها.
  displayName String?
  bio         String?
  avatarUrl   String?
  tokenVersion        Int        @default(0)
  lastLoginAt         DateTime?
  lastLoginIp         String?
  lastLoginUserAgent  String?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime   @default(now())
  lists               TodoList[]

  // ===== كود الاسترجاع (بديل مجاني/فوري لاسترجاع كلمة المرور بدل الإيميل) =====
  // بيتولّد كود عشوائي عالي الإنتروبيا مرة واحدة بعد التسجيل (أو بعد إعادة
  // التأهيل)، وبيتعرض للمستخدم مرة واحدة بس عشان يحفظه. المُخزّن هنا هو الـ
  // hash بتاعه فقط (SHA-256) — زي التوكنات المؤقتة بالظبط، مش الكود نفسه.
  // لو المستخدم نسي الباسورد بعدين، بيستخدم اسم المستخدم + الكود ده بدل ما
  // يستنى إيميل. كل مرة يتستخدم فيها الكود بينولّد كود جديد بيحل محل القديم.
  recoveryCodeHash      String?
  recoveryCodeCreatedAt DateTime?

  passwordUpdatedAt DateTime?

  // ===== خصم الاستريك (Streak Penalty) — خريطة الأهداف، المرحلة 7 =====
  // عداد تراكمي لعدد أيام الاستريك اللي اتخصمت بسبب "مهام متأخرة" في خريطة
  // الأهداف (هدف/مهمة ليها وقت نهاية (endTime) عدّى معادها بـ 10 دقايق من
  // غير ما المستخدم يخلّصها — شوف lib/overdueScheduler.ts). الاستريك
  // المعروض فعليًا = max(0, (الاستريك المحسوب من UserActivityDay) − streakPenalty)
  // — الاستريك متوقّفش ينزل تحت صفر (شوف routes/streak.ts). الخصم دائم عمدًا: استرجاع
  // المهمة المتأخرة وتعديلها بيرجّعها نشطة تاني، لكن مبيرجّعش يوم الاستريك
  // المخصوم — العقوبة على التأخير نفسه، مش على المهمة.
  streakPenalty Int @default(0)

  // ===== إعادة تأهيل الحسابات القديمة (Username+Password بسيط، من غير كود استرجاع) =====
  // legacyAccount: علامة تاريخية دايمة إن الحساب ده أصله من النظام القديم.
  // mustRehabilitate: طالما true، الحساب ممنوع يستخدم أي حاجة في الموقع غير
  // مسار إعادة التأهيل نفسه (شوف middleware/rehabilitationGate.ts)، وده بيتصفّر
  // تلقائيًا أول ما المستخدم يختار كلمة مرور جديدة قوية ويستلم كود استرجاعه.
  // مفيش داعي لتشغيل أي سكريبت يدوي: أي حساب مالوش recoveryCodeHash لسه بيتكشف
  // تلقائيًا كحساب قديم أول ما يحاول يسجّل دخول (شوف routes/auth.ts).
  legacyAccount    Boolean   @default(false)
  mustRehabilitate Boolean   @default(false)
  rehabilitatedAt  DateTime?

  reminders         Reminder[]
  pushSubscriptions PushSubscription[]
  lifeAreas         LifeArea[]
  activityDays      UserActivityDay[]
  notifications     Notification[]
  customDatabases   CustomDatabase[]

  // ===== الغرف الصوتية =====
  createdVoiceRooms VoiceRoom[]        @relation("VoiceRoomCreator")
  voiceRoomAccess   VoiceRoomAccess[]  @relation("VoiceRoomMember")
  voiceRoomMessages VoiceRoomMessage[]

  @@index([createdAt])
}

// ===== الاستريك (أيام الإنجاز المتتالية) =====
// صف واحد بس بيتسجّل لكل (مستخدم، يوم) أول ما مهمة رئيسية وحدة على الأقل
// تتؤرشف فعليًا (يعني اكتملت بالكامل وأكّدها المستخدم — شوف lib/archive.ts).
// التسجيل دايم ومبيتمسحش حتى لو المستخدم بعدين رجّع المهمة وفتحها تاني،
// عشان اليوم ده فعلاً اتحقق فيه إنجاز مرة واحدة على الأقل. الاستريك الحالي
// (متتالي من النهاردة/إمبارح للخلف) بيتحسب "live" من الجدول ده وقت الطلب
// (شوف routes/streak.ts) بدل ما يتخزن كعداد ممكن يتعارض مع البيانات الفعلية.
model UserActivityDay {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

// ===== إشعارات الموقع (Inbox) =====
// رسالة/إشعار داخلي بيظهر في جرس الإشعارات جنب زرار القائمة (Menu Bar).
// مصدرها إما النظام نفسه (SYSTEM — زي تذكير مهمة استحق موعده، شوف
// lib/reminderScheduler.ts) أو الأدمن (ADMIN — رسالة عامة أو لمستخدم معيّن
// من لوحة التحكم، شوف routes/adminContent.ts). isRead بتتحول true لما
// المستخدم يفتحها أو يضغط "تعليم الكل كمقروء".
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title  String
  body   String
  source NotificationSource @default(SYSTEM)
  url    String?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

enum NotificationSource {
  ADMIN
  SYSTEM
}

// ===== مجالات الحياة (Life Areas) =====
// نظام تصنيف أعلى مستوى من TaskCategory (يومي/أسبوعي/إلخ): بدل ما يوصف
// "امتى" المهمة، بيوصف "في أي جانب من حياة المستخدم" هي (صحة، شغل، عائلة...).
// كل مستخدم بيعرّف مجالاته الخاصة بحرية كاملة (اسم + لون + أيقونة إيموجي أو
// صورة مرفوعة)، وكل مهمة رئيسية (TodoList) ممكن تتبع مجال واحد بس (اختياري).
// position بيحدد ترتيب العرض المخصص اللي المستخدم رتبه بنفسه.
model LifeArea {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  color String  @default("#7c3aed")
  // أيقونة إيموجي بسيطة (اختياري) — بتتجاهل في الواجهة لو فيه imageUrl مرفوع.
  icon  String?
  // صورة أيقونة مخصصة رفعها المستخدم من جهازه، بتحل محل الإيموجي في العرض.
  imageUrl String?
  // position بقى مرتب *داخل نفس المستوى* بس (بين إخوته اللي ليهم نفس
  // parentId)، مش بين كل مجالات المستخدم على بعضها — كده كل فرع بيرتب
  // نفسه لوحده.
  position Int     @default(0)

  // ===== الهيكل الهرمي (مجالات فرعية) =====
  // مجال الحياة ممكن يتبع مجال حياة أب (parentId)، وبيقدر بدوره يكون
  // أب لمجالات فرعية تانية (children) — من غير حد أقصى لعدد المستويات.
  // لو المجال الأب اتحذف، مجالاته الفرعية ما بتتحذفش معاه؛ بترجع "مجالات
  // جذرية" مستقلة (onDelete: SetNull) — بنفس فلسفة "الحذف ما بيكسرش
  // حاجة تانية" المتّبعة في كل المشروع.
  parentId String?
  parent   LifeArea?  @relation("LifeAreaHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children LifeArea[] @relation("LifeAreaHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lists          TodoList[]
  customDatabases CustomDatabase[] (نفس parentId)، مش بين كل مجالات
  // المستخدم — عشان "الجري" تحت "الصحة" و"الجري" تحت "شغل" (مثلاً) يبقوا
  // مسموحين. ملحوظة: قيود UNIQUE في بوستجرس بتعتبر NULL≠NULL، فالتحقق من
  // فرادة الاسم بين المجالات الجذرية (parentId=null) بيتم يدويًا في السيرفر
  // (شوف routes/lifeAreas.ts) بدل الاعتماد على القيد ده لوحده.
  @@unique([userId, parentId, name])
  @@index([userId])
  @@index([userId, position])
  @@index([parentId])
}

model AdminAuditLog {
  id             String   @id @default(cuid())
  adminUsername  String
  targetUsername String?
  action         String
  ip             String?
  createdAt      DateTime @default(now())
}

// ===== قواعد بيانات مخصصة (Databases) — المرحلة 1 =====
// فكرة مستوحاة من Notion Databases: جدول مرن يقدر المستخدم يعرّف أعمدته
// (خصائصه) بنفسه بدل ما يبقى شكل ثابت زي المهام العادية. كل قاعدة بيانات
// ممكن (اختياريًا) تتربط بمجال حياة معيّن (lifeAreaId) عشان تظهر جوّه
// صفحته، أو تفضل عامة (lifeAreaId = null) لو مش مرتبطة بمجال بعينه.
// المرحلة 1 بتغطي View جدول واحد بس بخصائص أساسية — الأنواع المتقدمة
// (Relation/Formula/Board/Calendar) هتتضاف في مراحل لاحقة فوق نفس الأساس ده.
model CustomDatabase {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // لو المستخدم ربط القاعدة بمجال حياة، وانحذف المجال ده، القاعدة نفسها
  // بتفضل موجودة (SetNull) — نفس فلسفة "الحذف ما بيكسرش حاجة تانية"
  // المتّبعة مع TodoList.lifeAreaId في باقي المشروع.
  lifeAreaId String?
  lifeArea   LifeArea? @relation(fields: [lifeAreaId], references: [id], onDelete: SetNull)

  name  String
  icon  String?
  color String  @default("#7c3aed")

  // ===== المرحلة 2: عرض Board (كانبان) =====
  // viewType بيحدد شكل العرض الافتراضي للقاعدة (table أو board). لو board،
  // boardGroupById بيحدد أي خاصية (لازم تكون من نوع select) بتتحول لأعمدة
  // الكانبان — كل خيار فيها بيبقى عمود، وتحريك الصف بين الأعمدة معناه تغيير
  // قيمته في الخاصية دي. onDelete: SetNull عشان لو الخاصية اتحذفت، القاعدة
  // ترجع تلقائيًا لعرض الجدول من غير ما تتكسر.
  viewType       String            @default("table")
  boardGroupById String?
  boardGroupBy   DatabaseProperty? @relation("DatabaseBoardGroupBy", fields: [boardGroupById], references: [id], onDelete: SetNull)

  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties DatabaseProperty[]
  rows       DatabaseRow[]
  // خصائص Relation (من أي قاعدة، حتى من نفسها) اللي بتستهدف القاعدة دي —
  // reverse side بس، مفيش حاجة بتتخزن هنا مباشرة.
  incomingRelationProperties DatabaseProperty[] @relation("DatabaseRelationTarget")

  @@index([userId])
  @@index([userId, lifeAreaId])
}

// أنواع الخصائص المدعومة في المرحلة 1 — نص، رقم، اختيار واحد، اختيار
// متعدد، تاريخ، وصح/خطأ. باقي الأنواع (Relation/Formula/Person/...) هتتضاف
// بمراحل لاحقة من غير ما تكسر البيانات الموجودة (enum بيتقبل إضافة قيم جديدة).
enum DatabasePropertyType {
  text
  number
  select
  multiSelect
  date
  checkbox
  relation
}

// عمود/خاصية في قاعدة بيانات — بيوصف *شكل* البيانات بس، مش قيمها (القيم
// الفعلية في DatabaseRowValue). لخصائص select/multiSelect، الخيارات
// المتاحة (نص + لون كل خيار) متخزنة في options كـ JSON، مثلاً:
// [{ "value": "قيد التنفيذ", "color": "#f59e0b" }, ...]
model DatabaseProperty {
  id         String               @id @default(cuid())
  databaseId String
  database   CustomDatabase       @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  name     String
  type     DatabasePropertyType
  options  Json?
  position Int                  @default(0)

  // ===== المرحلة 4: Relations بين قواعد بيانات مختلفة =====
  // لو النوع relation، relatedDatabaseId بيحدد القاعدة "الهدف" اللي الخاصية
  // دي بتربط بصفوفها (ممكن تكون نفس القاعدة — self-relation، زي "مهام
  // مرتبطة"). القيمة الفعلية لكل صف (مصفوفة IDs بتاعة صفوف من القاعدة
  // الهدف) متخزنة عادي في DatabaseRowValue زي أي خاصية تانية. onDelete:
  // Cascade هنا (مختلف عن باقي الروابط الاختيارية في المشروع) لأن خاصية
  // Relation من غير قاعدة هدف مالهاش أي معنى — لو القاعدة الهدف اتحذفت،
  // الخاصية بتتحذف معاها (وقيمها Cascade كمان زي أي خاصية بتتحذف).
  relatedDatabaseId String?
  relatedDatabase   CustomDatabase? @relation("DatabaseRelationTarget", fields: [relatedDatabaseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values                   DatabaseRowValue[]
  databasesUsingAsBoardBy CustomDatabase[]    @relation("DatabaseBoardGroupBy")

  @@index([databaseId])
  @@index([databaseId, position])
  @@index([relatedDatabaseId])
}

// صف واحد في القاعدة (يعني "عنصر" واحد — كتاب، فيلم، مصروف... حسب استخدام
// المستخدم). قيمه الفعلية موزّعة على DatabaseRowValue، صف لكل خاصية.
model DatabaseRow {
  id         String         @id @default(cuid())
  databaseId String
  database   CustomDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  // ===== المرحلة 3: ربط صف بمهمة فعلية =====
  // لو المستخدم حوّل الصف ده لمهمة حقيقية، linkedTodoListId بيخزّن الـ id
  // بتاع الـ TodoList اللي اتعملت. onDelete: SetNull عشان لو المهمة اتحذفت
  // من قائمة المهام، الصف يفضل موجود وبس يرجع "مش مربوط" تلقائيًا.
  linkedTodoListId String?
  linkedTodoList   TodoList? @relation(fields: [linkedTodoListId], references: [id], onDelete: SetNull)

  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values DatabaseRowValue[]

  @@index([databaseId])
  @@index([databaseId, position])
  @@index([linkedTodoListId])
}

// قيمة خاصية معيّنة لصف معيّن. القيمة نفسها متخزنة كـ JSON عشان عمود واحد
// يستوعب كل الأنواع (نص خام، رقم، تاريخ ISO، true/false، أو مصفوفة نصوص
// لـ multiSelect) من غير ما نحتاج عمود منفصل لكل نوع.
model DatabaseRowValue {
  id String @id @default(cuid())

  rowId String
  row   DatabaseRow @relation(fields: [rowId], references: [id], onDelete: Cascade)

  propertyId String
  property   DatabaseProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  value Json?

  // صف واحد مايستحملش قيمتين لنفس الخاصية.
  @@unique([rowId, propertyId])
  @@index([propertyId])
}

// TodoList بتمثّل "المهمة الرئيسية" في واجهة المستخدم — عنوانها وأولويتها
// بيوصفوا الهدف الكبير، وكل عناصرها (TodoItem) دي المهام الفرعية اللي بتتحقق
// بيها المهمة الرئيسية خطوة خطوة.
model TodoList {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String     @default("قائمتي")
  priority  Priority   @default(NONE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     TodoItem[]
  reminders Reminder[]
  linkedDatabaseRows DatabaseRow[]

  // ===== مؤقت المهمة الرئيسية (Task Timeline) =====
  // بيتفعّل بس لو الاتنين متحددين مع بعض (وقت البداية لازم يكون قبل وقت
  // النهاية — بيتفحص ده في السيرفر). الواجهة بتستخدمهم لعرض شريط زمني
  // متحرك بيتناقص لحد ما ينتهي الوقت، من غير ما تحتاج تستقصي السيرفر كل شوية
  // لأن الحساب كله بيتم في المتصفح اعتمادًا على الوقتين دول بس.
  startTime DateTime?
  endTime   DateTime?

  // ===== تصنيف المهمة الرئيسية (يومية/أسبوعية/شهرية/سنوية) =====
  // category بيبقى null لحد ما المستخدم يختار تصنيف بنفسه (غير مصنّفة).
  // targetYear بيتفعّل بس لما category يكون YEARLY، وبيتصفّر تلقائيًا لو
  // المستخدم غيّر التصنيف لحاجة تانية (شوف routes/lists.ts).
  category   TaskCategory?
  targetYear Int?

  // ===== خانات التقويم الهرمي (شهر/أسبوع/يوم) =====
  // بتُستخدم حصريًا في "خريطة العرض الكاملة" (GoalMap Zoom Navigation)
  // عشان نقدر نعرض شبكة تقويمية حقيقية (12 شهر بأرقامهم، أسابيع الشهر،
  // أيام الأسبوع) بدل قائمة أسماء أهداف مجردة. كل حقل بيتفعّل بس مع
  // تصنيفه المقابل وبيتصفّر تلقائيًا لو التصنيف اتغيّر لحاجة تانية (نفس
  // فلسفة targetYear بالظبط — شوف routes/lists.ts):
  // - targetMonth: 1-12، بس لهدف شهري (MONTHLY) — رقم الشهر في السنة.
  // - targetWeek: 1-5، بس لهدف أسبوعي (WEEKLY) — ترتيب الأسبوع جوه الشهر
  //   اللي هدفه الشهري الأب واقع فيه (مش رقم أسبوع السنة).
  // - targetDayOfWeek: 0-6 (السبت=0 ... الجمعة=6)، بس لهدف يومي (DAILY) —
  //   أنهي يوم من أيام الأسبوع اللي هدفه الأسبوعي الأب واقع فيه.
  targetMonth     Int?
  targetWeek      Int?
  targetDayOfWeek Int?

  // ===== مجال الحياة (Life Area) =====
  // اختياري تمامًا — null يعني "غير مصنّفة ضمن أي مجال". لو المجال اتحذف،
  // المهمة مش بتتحذف معاه، بس بترجع "بدون مجال" (onDelete: SetNull).
  lifeAreaId String?
  lifeArea   LifeArea? @relation(fields: [lifeAreaId], references: [id], onDelete: SetNull)

  // ===== الأرشفة (Archive) =====
  // archivedAt بتبقى null طول ما المهمة نشطة. أول ما كل مهامها الفرعية
  // تتحقق (isDone = true للكل، وفيه مهمة فرعية واحدة على الأقل)، السيرفر
  // بيسجّل توقيت الإكمال هنا تلقائيًا وبيك تختفي من القائمة الرئيسية
  // وتظهر في الأرشيف بدالها. لو المستخدم بعدين رجّع مهمة فرعية "غير منجزة"،
  // بترجع أوتوماتيك للقائمة النشطة (archivedAt بيترجع null) — شوف
  // lib/archive.ts. المستخدم كمان يقدر يؤرشف/يسترجع يدويًا في أي وقت.
  archivedAt DateTime?

  // ===== تأكيد الإنجاز النهائي (Final Completion Confirmation) =====
  // confirmedDone بتفضل false حتى لو كل المهام الفرعية اتعلّمت done. المهمة
  // الرئيسية متتؤرشفش تلقائيًا إلا لو المستخدم علّم بنفسه على مربع التأكيد
  // النهائي (وده مسموح بيه بس لما تكون كل المهام الفرعية منجزة فعلاً — شوف
  // routes/lists.ts و lib/archive.ts). أي تغيير يخلي المهام الفرعية مش كلها
  // منجزة بيصفّر القيمة دي تلقائيًا عشان التأكيد لازم يتكرر في كل مرة.
  confirmedDone Boolean @default(false)

  // ===== استرجاع من الأرشيف بانتظار المراجعة (Pending Restore) =====
  // لما المستخدم يضغط "استرجاع" من صفحة الأرشيف، المهمة مبترجعش فورًا
  // لقائمة المهام النشطة — بتتحط في "منطقة انتظار" وسيطة (pendingRestoreAt
  // بيسجّل توقيت الاسترجاع الأولي). المهمة بتظهر وقتها في قسم مخصص بالصفحة
  // الرئيسية (قابل للتعديل بالكامل)، ومبتترجعش لمكانها الطبيعي في القائمة
  // النشطة إلا لما المستخدم يأكّد بالضغط على "إضافة المهمة" (pendingRestoreAt
  // بيترجع null وقتها). طول ما فيه قيمة هنا، بيتوقف مزامنة الأرشفة التلقائية
  // (syncListArchiveState) عن أي تغيير في حالة المهمة دي — شوف lib/archive.ts.
  pendingRestoreAt DateTime?

  // ===== سبب الأرشفة (Archive Reason) =====
  // بيفرّق بين نوعين مختلفين تمامًا من الأرشفة، وبيتحدد بس وقت ما archivedAt
  // بتتحط فعليًا (يفضل من غير معنى طول ما archivedAt = null):
  // - COMPLETED: المستخدم خلّص المهمة فعلاً وأكّدها (أو أرشفها يدويًا) —
  //   دي بتظهر في تبويب "المهام المنجزة" وتقدر تتسترجع/تتحذف عادي.
  // - OVERDUE: المهمة ليها وقت نهاية محدد (endTime) وعدّى موعدها بـ 10
  //   دقايق كامل من غير ما المستخدم يخلّصها — بتتأرشف تلقائيًا (شوف
  //   lib/overdueScheduler.ts) وبتظهر في تبويب "المهام المتأخرة" بشكل
  //   دائم وغير قابلة للحذف أو الاسترجاع، عشان تفضل سجل ثابت وصادق لأي
  //   مهمة فات معادها. أي محاولة استرجاع/حذف/تعديل مهام فرعية لمهمة
  //   بالحالة دي لازم تترفض في السيرفر (شوف routes/lists.ts وroutes/items.ts
  //   ولib/archive.ts).
  archiveReason ArchiveReason @default(COMPLETED)

  // ===== خريطة الأهداف الهرمية (سنوي ← شهري ← أسبوعي ← يومي) =====
  // parentGoalId بيربط المهمة الرئيسية دي بـ"الهدف الأب" اللي بتساهم في
  // تحقيقه. الربط اختياري ومسموح بس بين مستويين متتاليين في الهرم (شوف
  // PARENT_CATEGORY_OF والتحقق في routes/lists.ts): هدف شهري لازم أبوه
  // سنوي، أسبوعي لازم أبوه شهري، يومي لازم أبوه أسبوعي — والهدف السنوي
  // نفسه يفضل من غير أب لأنه قمة الهرم. لو الهدف الأب اتحذف، الأهداف
  // الفرعية بترجع "بدون أب" (onDelete: SetNull) بدل ما تتحذف معاه، بنفس
  // فلسفة عدم الحذف المتسلسل المتّبعة في كل المشروع. subGoals هو العكس:
  // كل الأهداف الفرعية المربوطة بالهدف ده، بتُستخدم لحساب نسبة الإنجاز
  // الإجمالية للهدف (كام هدف فرعي خلص من كام).
  parentGoalId String?
  parentGoal   TodoList?  @relation("GoalHierarchy", fields: [parentGoalId], references: [id], onDelete: SetNull)
  subGoals     TodoList[] @relation("GoalHierarchy")

  // ===== سلة المحذوفات المؤقتة (Trash) — حذف سنة كاملة من خريطة الأهداف =====
  // بتتفعّل بس لما المستخدم يعمل ضغطة مطوّلة على تبويب سنة في خريطة الأهداف
  // ويأكّد الحذف (شوف routes/trash.ts). trashedAt بيبقى null طول ما المهمة
  // نشطة عادي. لما المستخدم يحذف سنة، كل الأهداف اللي تحتها على كل
  // المستويات (سنوي ← شهري ← أسبوعي ← يومي) بتاخد نفس trashedAt (توقيت
  // الحذف) ونفس trashedYear (السنة اللي اتحذفت، محفوظة هنا مباشرة بدل ما
  // نحتاج نتسلّق شجرة parentGoalId تاني كل مرة) — كده استرجاع/عرض السنة كلها
  // بيبقى استعلام واحد بسيط. المهمة المحذوفة بتختفي فورًا من كل الشاشات
  // التانية (القائمة النشطة، الأرشيف، خريطة الأهداف) وبتظهر بس في تبويب
  // "المحذوفات" الجديد. بعد 5 أيام من trashedAt، جدولة lib/trashScheduler.ts
  // بتحذفها نهائيًا من قاعدة البيانات (لا رجعة). المستخدم يقدر يسترجع كل حاجة
  // في أي وقت قبل الـ 5 أيام دي (trashedAt/trashedYear بيرجعوا null، وكل حاجة
  // بترجع بالظبط زي ما كانت — بما فيها حالة الأرشفة الأصلية لو كانت موجودة).
  trashedAt   DateTime?
  trashedYear Int?

  // ===== منطق الإنجاز الجديد + المهام المتأخرة (خريطة الأهداف، المرحلة 7) =====
  // overduePenalizedAt خاص بأهداف/مهام خريطة الأهداف بس (category مش null).
  // بيتفعّل تلقائيًا (شوف lib/overdueScheduler.ts) لما يكون للهدف وقت نهاية
  // محدد (endTime) وعدّى معاده بـ OVERDUE_GRACE_MINUTES (10 دقايق) من غير
  // ما المستخدم يخلّصه (confirmedDone لسه false) — على عكس المهام العادية
  // (category = null) اللي بتتنقل تلقائيًا لأرشيف "المهام المتأخرة"، هدف
  // خريطة الأهداف بيفضل في مكانه الطبيعي بالظبط (نشط، مش مؤرشف) عشان
  // المستخدم يقدر يراجعه ويعدّله من نفس صفحة خريطة الأهداف، لكن بيتحط
  // عليه العلامة دي عشان يظهر بشكل لافت أعلى الصفحة، ومع الخصم الفوري ليوم
  // واحد من User.streakPenalty (مرة واحدة بس لكل مرة يتأخر فيها — العلامة
  // نفسها بتمنع التكرار). بترجع null تلقائيًا أول ما المستخدم يعدّل تفاصيل
  // الهدف (PATCH /:id في routes/lists.ts) أو يأكّد إنجازه (POST
  // /:id/confirm-done) — يعني "راجعته وحطيته تاني"، لكن يوم الاستريك
  // المخصوم فضل مخصوم عمدًا (شوف تعليق streakPenalty في User فوق).
  overduePenalizedAt DateTime?

  @@unique([userId, title])
  @@index([userId])
  @@index([lifeAreaId])
  @@index([userId, archivedAt])
  @@index([userId, pendingRestoreAt])
  @@index([archivedAt, endTime])
  @@index([parentGoalId])
  @@index([userId, trashedAt])
  @@index([userId, trashedYear])
}

// TodoItem بتمثّل "المهمة الفرعية" جوه المهمة الرئيسية.
model TodoItem {
  id        String    @id @default(cuid())
  listId    String
  list      TodoList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  content   String
  isDone    Boolean   @default(false)
  position  Int       @default(0)
  dueDate   DateTime?
  priority  Priority  @default(NONE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  reminders Reminder[]

  @@index([listId])
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// شوف تعليق الحقل archiveReason فوق في TodoList لتفاصيل الفرق بين الحالتين.
enum ArchiveReason {
  COMPLETED
  OVERDUE
}

// تصنيف المهمة الرئيسية — بيحدد تحت أي قسم بتظهر المهمة (يومية/أسبوعية/
// شهرية/سنوية). المهام السنوية بس هي اللي بتستخدم targetYear في TodoList.
enum TaskCategory {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// وضع التذكير: CUSTOM = وقت مطلق يحدده المستخدم بنفسه، BEFORE_DUE = فترة
// زمنية (offsetMinutes) قبل موعد استحقاق المهمة نفسها (dueDate). لما يكون
// الوضع BEFORE_DUE بنحتفظ بالـ offset عشان لو المستخدم غيّر موعد الاستحقاق
// بعدين، نقدر نعيد حساب remindAt تلقائيًا من غير ما نفقد قصد المستخدم الأصلي.
enum ReminderMode {
  CUSTOM
  BEFORE_DUE
}

// تذكير واحد بيتبع إما مهمة رئيسية (listId) أو مهمة فرعية (itemId) — واحد
// بس مننهم لازم يكون متحدد (بيتفحص ده في السيرفر). المهمة الرئيسية معندهاش
// موعد استحقاق (dueDate)، فالتذكيرات بتاعتها بتقبل وضع CUSTOM بس، أما المهمة
// الفرعية فبتقبل الوضعين لو ليها موعد استحقاق محدد.
model Reminder {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  listId String?
  list   TodoList? @relation(fields: [listId], references: [id], onDelete: Cascade)
  itemId String?
  item   TodoItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  mode          ReminderMode @default(CUSTOM)
  offsetMinutes Int?
  remindAt      DateTime
  message       String?

  isSent Boolean   @default(false)
  sentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([listId])
  @@index([itemId])
  @@index([remindAt, isSent])
}

// اشتراك Web Push واحد لكل جهاز/متصفح سجّل المستخدم دخوله منه. مستخدم واحد
// ممكن يكون عنده أكتر من اشتراك (موبايل + تابلت مثلًا)، فبنبعت الإشعار
// لكل الأجهزة المسجلة مرة واحدة.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// إعدادات الموقع العامة، مخزّنة كـ key/value عشان نقدر نضيف إعدادات جديدة
// في المستقبل من غير ما نحتاج migration جديد لكل إعداد. لوحة تحكم الأدمن
// (تبويب "الإعدادات") هي المصدر الوحيد لتعديلها.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ===== الغرف الصوتية (Voice Rooms) =====
// غرفة "صوتية" بدون مايك: زي غرف ديسكورد الصوتية لكن بدون كلام حي. الدخول
// محصور بالأعضاء اللي الأدمن دّاهم صلاحية دخول ليها بس (VoiceRoomAccess)،
// وجوه الغرفة فيه شات نصي بين الأعضاء المتواجدين. الأدمن بس يقدر يكتب أمر
// "شغل ..." في شات الغرفة، فيتشغّل صوت تلاوة (عن طريق نفس محرك بحث يوتيوب
// بتاع مشغّل القرآن، شوف services/quranSearch.ts) لكل الأعضاء المتواجدين
// في نفس اللحظة، وكل عضو يتحكم في مستوى صوته هو بس عنده (شوف
// realtime/voiceRooms.ts لمنطق الانضمام/الشات/البث نفسه — الحالة الحيّة
// لكل غرفة (مين متواجد دلوقتي، وهي شغّالة إيه) بتتخزّن في الذاكرة بس، مش
// في القاعدة، عشان دي حالة لحظية مش سجل دائم).
model VoiceRoom {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  // الأدمن يقدر يقفل الشات مؤقتًا (مايمنعش هو من الكتابة، بس بيمنع باقي
  // الأعضاء) — بيتفحص وقت إرسال أي رسالة عادية في realtime/voiceRooms.ts.
  chatLocked Boolean @default(false)

  // أقصى عدد أعضاء بني آدمين يقدروا يبقوا متواجدين في نفس اللحظة (مش شامل
  // بوت مشغّل القرآن). null = بلا حدود، زي ما الأدمن يختار بالظبط.
  maxMembers Int?

  createdById String?
  createdBy   User?   @relation("VoiceRoomCreator", fields: [createdById], references: [id], onDelete: SetNull)

  access   VoiceRoomAccess[]
  messages VoiceRoomMessage[]

  @@index([createdAt])
}

// صلاحية دخول عضو معيّن لغرفة معيّنة — العضو اللي معندوش صف هنا (ومش
// أدمن) مش هيقدر ينضم للغرفة خالص، لا من الواجهة ولا حتى لو حاول يكلّم
// الـ socket مباشرة (الفحص بيتم في السيرفر وقت الانضمام).
model VoiceRoomAccess {
  id     String    @id @default(cuid())
  roomId String
  room   VoiceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation("VoiceRoomMember", fields: [userId], references: [id], onDelete: Cascade)

  // اسم الأدمن اللي منح الصلاحية دي، محفوظ كنص ثابت وقت المنح (مش علاقة)
  // عشان يفضل واضح مين اللي سمح حتى لو حساب الأدمن ده اتغيّر أو اتحذف بعدين.
  grantedByUsername String?
  createdAt         DateTime @default(now())

  // دور العضو جوه الغرفة دي بالذات (مش نفس isAdmin العام بتاع الحساب):
  // "member" العادي، أو "moderator"/"admin" لو الأدمن العام رقّاه — بيدّيله
  // صلاحيات زي أدمن الغرفة (تثبيت/حذف رسايل، طرد/كتم أعضاء...) جوه الغرفة
  // دي بس، من غير ما يبقى أدمن عام على التطبيق كله.
  role String @default("member")

  // كتم في الشات — يقدر يسمع ويتواجد بس مايقدرش يكتب رسايل.
  isMuted Boolean @default(false)
  // حظر — زي الحرمان بس أدوم؛ حتى لو اتمنح صلاحية دخول تانية بعدين، الحظر
  // بيفضل شغال لحد ما الأدمن يفكّه صراحة (مختلف عن مجرد سحب الصلاحية).
  isBanned Boolean @default(false)

  @@unique([roomId, userId])
  @@index([userId])
}

// رسالة شات داخل غرفة صوتية. isSystem بتتحط true للرسائل التلقائية (عضو
// دخل/خرج، الأدمن شغّل تلاوة...) عشان الواجهة تعرضها بشكل مختلف عن رسائل
// الأعضاء العادية. username محفوظ كنص ثابت وقت الإرسال (مش بس علاقة مع
// User) عشان لو المستخدم اتحذف بعدين الرسايل القديمة تفضل مفهومة.
model VoiceRoomMessage {
  id     String    @id @default(cuid())
  roomId String
  room   VoiceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  username String
  isAdmin  Boolean @default(false)
  body     String
  isSystem Boolean @default(false)

  // تثبيت الرسالة — الأدمن بس يقدر يثبّت/يفك تثبيت (زي ديسكورد).
  isPinned Boolean @default(false)
  // حذف منطقي (soft delete) — الأدمن يقدر يحذف رسالة أي حد، أو أي عضو
  // يقدر يحذف رسالته هو بس. الرسالة بتفضل في القاعدة لكن بتظهر "تم حذفها".
  isDeleted Boolean @default(false)
  // أسماء المستخدمين اللي اتعمللهم منشن (@اسم) في الرسالة دي، متخزّنة كنص
  // JSON بسيط (مصفوفة usernames) عشان نبعت إشعار فوري للي اتعمله منشن.
  mentions String?

  // مرفق اختياري (صورة / فيديو / رسالة صوتية / ملف عام). لو موجود، ممكن
  // body يبقى فاضي (رسالة مرفق بس من غير نص).
  attachmentUrl  String?
  attachmentType String? // image | video | audio | file
  attachmentName String?
  attachmentMime String?
  attachmentSize Int?

  // رد على رسالة تانية (اختياري) — بنحفظ بس المرجع، والواجهة بتجيب بيانات
  // الرسالة الأصلية من القايمة المحمّلة أصلًا عندها (أو بتعرض "رسالة محذوفة"
  // لو مبقتش موجودة).
  replyToId String?
  replyTo   VoiceRoomMessage?  @relation("VoiceRoomMessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   VoiceRoomMessage[] @relation("VoiceRoomMessageReply")

  reactions VoiceRoomMessageReaction[]

  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

// تفاعل (إيموجي) عضو على رسالة معيّنة — عضو واحد يقدر يحط نفس الإيموجي مرة
// واحدة بس على نفس الرسالة (تاني ضغطة على نفس الإيموجي بتشيله — Toggle).
model VoiceRoomMessageReaction {
  id        String           @id @default(cuid())
  messageId String
  message   VoiceRoomMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  username  String
  emoji     String
  createdAt DateTime         @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}
